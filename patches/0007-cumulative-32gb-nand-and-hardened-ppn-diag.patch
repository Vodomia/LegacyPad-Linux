+    def test_interrupted_write_and_recovery_simulation(self):
+        """Simulate primary (LBA 0) vs backup (LBA 8191 on 32GB, LBA 4095 on 16GB) dual-header states."""
+        # 1. Genuine interrupted write: LBA 0 updated, LBA 8191 has stale/zero data
+        lba0_updated = self.now_32_raw
+        lba8191_stale = bytes(4096)
+        self.assertNotEqual(lba0_updated, lba8191_stale)
