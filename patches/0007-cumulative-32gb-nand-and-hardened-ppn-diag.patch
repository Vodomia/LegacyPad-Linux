+def check_ios_utilities():
+    """Verify presence of required read-only tools on target iOS system."""
+    check_script = 'for u in sysctl dmesg ioreg dd; do command -v "$u" >/dev/null 2>&1 || echo "MISSING:$u"; done'
+    out = run_ios_cmd(check_script)
+    missing = []
+    if out is not None:
+        for line in out.splitlines():
+            if line.startswith('MISSING:'):
+                missing.append(line.split(':', 1)[1].strip())
+    return missing
