+        self.assertEqual(res_valid['chunk_size_mib'], 32)
+        self.assertEqual(res_valid['backup_lba'], 8191)
+
+        # 2. Corrupt CRC must be strictly rejected
+        corrupt_crc = bytearray(self.now_32_raw)
+        corrupt_crc[0x900] ^= 0x55
+        res_crc = nand_diagnose.parse_lwvm_header(bytes(corrupt_crc))
+        self.assertFalse(res_crc['valid'])
+        self.assertIn('CRC32 mismatch', res_crc['error'])
+
+        # 3. Invalid magic must be rejected
+        corrupt_magic = bytearray(self.now_32_raw)
+        corrupt_magic[0] ^= 0xFF
+        res_magic = nand_diagnose.parse_lwvm_header(bytes(corrupt_magic))
+        self.assertFalse(res_magic['valid'])
+        self.assertIn('Invalid magic', res_magic['error'])
+
+        # 4. Out-of-bounds partition must be rejected
+        h_bad_bound = lwvm.Header(self.now_32_raw)
+        h_bad_bound.parts[1].end = h_bad_bound.bound + (32 << 20)
+        res_bound = nand_diagnose.parse_lwvm_header(h_bad_bound.pack())
+        self.assertFalse(res_bound['valid'])
+        self.assertIn('out of bounds', res_bound['error'])
+
+        # 5. Incomplete data must block hardware readiness
