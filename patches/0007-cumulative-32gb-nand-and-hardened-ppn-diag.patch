+def get_ios_ssh_base():
+    """Derive SSH invocation based on Cascadia environment, USB proxy, or standard Wi-Fi/SSH."""
+    if os.environ.get('IOS_SSH_CMD'):
+        return shlex.split(os.environ['IOS_SSH_CMD'])
+
+    ios_host = os.environ.get('IOS_HOST')
+    ios_port = os.environ.get('IOS_PORT', '22')
+
+    cascadia_root = os.environ.get('CASCADIA_ROOT')
+    if not cascadia_root:
+        # Check standard relative paths
+        here = os.path.dirname(os.path.abspath(__file__))
+        cand = os.path.abspath(os.path.join(here, '../../../../Project-Cascadia'))
+        if os.path.isdir(cand):
+            cascadia_root = cand
+
+    usbmux_script = None
+    if cascadia_root and os.path.isfile(os.path.join(cascadia_root, 'lib/usbmux.py')):
+        usbmux_script = os.path.join(cascadia_root, 'lib/usbmux.py')
+
+    ssh_base = [
+        'ssh',
+        '-o', 'ConnectTimeout=10',
+        '-o', 'BatchMode=yes',
+        '-o', 'StrictHostKeyChecking=no',
+        '-o', 'UserKnownHostsFile=/dev/null',
+    ]
+
+    if ios_host:
+        return ssh_base + ['-p', ios_port, f'root@{ios_host}']
+    elif usbmux_script and os.path.exists('/var/run/usbmuxd'):
+        proxy_cmd = f"python3 '{usbmux_script}' connect {ios_port}"
+        return ssh_base + ['-o', f'ProxyCommand={proxy_cmd}', 'root@ios']
+    else:
+        # Fallback to local port forwarding tunnel (iproxy localhost:2222)
+        local_port = os.environ.get('IOS_LOCAL_PORT', '2222')
+        local_ip = os.environ.get('IOS_LOCAL_IP', 'localhost')
+        return ssh_base + ['-p', local_port, f'root@{local_ip}']
+
+
+def run_ios_cmd(cmd):
+    """Run command on iOS device over SSH and return stdout or None."""
+    ssh_cmd = get_ios_ssh_base() + [cmd]
+    try:
+        res = subprocess.run(ssh_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=15)
+        if res.returncode == 0:
+            return res.stdout.strip()
+    except Exception:
+        pass
+    return None
+
+
+def run_ios_cmd_bytes(cmd):
+    """Run command on iOS device over SSH and return binary stdout or None."""
+    ssh_cmd = get_ios_ssh_base() + [cmd]
+    try:
+        res = subprocess.run(ssh_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=20)
+        if res.returncode == 0:
+            return res.stdout
+    except Exception:
+        pass
+    return None
+
