+def parse_dmesg_ppn_diag(dmesg_text):
+    """Parse kernel dmesg output from read-only PPN diagnostic boot."""
+    info = {
+        'ppn_detected': False,
+        'firmware': None,
+        'controller_version': None,
+        'blocks': None,
+        'mlc_pages': None,
+        'slc_pages': None,
+        'page_bits': None,
+        'block_bits': None,
+        'cau_bits': None,
+        'read_only': None,  # Must remain UNKNOWN, never safely defaulting to True!
+        'write_allowed': None,  # UNKNOWN by default
+        'ftl_profile_selected': None,
+        'ftl_mounted': None,  # UNKNOWN by default
+        'pmu_charger_armed': False,
+    }
+    for line in dmesg_text.splitlines():
+        if 'apple_pmu_charger: armed' in line:
+            info['pmu_charger_armed'] = True
+        if 'apple_ppn' in line or 'ppn' in line.lower():
+            info['ppn_detected'] = True
+        if 'id PPN 1.5.5' in line or 'PPN 1.5.5' in line:
+            info['controller_version'] = 'PPN 1.5.5'
+        m_fw = re.search(r'package firmware\s+([0-9A-Za-z_]+)', line)
+        if m_fw:
+            info['firmware'] = m_fw.group(1)
+        m_geo = re.search(r'package geometry\s+(\d+)\s+blocks\s*x\s*(\d+)\s+pages\s*\(SLC\s*(\d+)\)', line)
+        if m_geo:
+            info['blocks'] = int(m_geo.group(1))
+            info['mlc_pages'] = int(m_geo.group(2))
+            info['slc_pages'] = int(m_geo.group(3))
+        m_bits = re.search(r'row bits page\s+(\d+)\s+block\s+(\d+)\s+cau\s+(\d+)', line)
+        if m_bits:
+            info['page_bits'] = int(m_bits.group(1))
+            info['block_bits'] = int(m_bits.group(2))
+            info['cau_bits'] = int(m_bits.group(3))
+
+        # Check for explicit write/read_only markers
+        if 'program/erase enabled' in line or 'apple_ppn.allow_write=1' in line:
+            info['write_allowed'] = True
+            info['read_only'] = False
+        elif 'unsupported, read-only' in line or 'read-only' in line:
+            if info['read_only'] is not False:
+                info['read_only'] = True
+                info['write_allowed'] = False
+
+        # Package profile vs actual FTL mount
+        if 'apple_ftl: package profile' in line:
+            info['ftl_profile_selected'] = True
+            # Selecting a package profile is NOT proof that an FTL filesystem is mounted!
+        if 'no FTL profile for a package of' in line:
+            info['ftl_profile_selected'] = False
+            info['ftl_mounted'] = False
+        if 'apple_ftl: mounted' in line or 'mounted as /dev/ftl' in line or 'registered /dev/ftl' in line:
+            info['ftl_mounted'] = True
+
+    return info
+
