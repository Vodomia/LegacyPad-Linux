+def parse_lwvm_header(raw):
+    """Strictly parse and validate an LwVM header block.
+    
+    Verifies:
+      - Block size exactly 4096 bytes
+      - Magic bytes (0x6a9088cf8afd630ae351e24887e0b98b)
+      - Independent CRC32 match
+      - Supported media size (16GB or 32GB)
+      - Partition count (1..8)
+      - Dynamic chunk geometry (16 MiB on 16GB, 32 MiB on 32GB)
+      - Partition boundaries, alignment, overlaps, and bounds
+      - Chunk map structure: Chunk 0 M_HEADER, past chunks M_PAST, valid partition sequences
+    """
+    if len(raw) != BLOCK:
+        return {'valid': False, 'error': f'Header length {len(raw)} != {BLOCK}'}
+    
+    if raw[:16] != MAGIC:
+        return {'valid': False, 'error': f'Invalid magic: {raw[:16].hex()}'}
+    
+    # Verify independent CRC32
+    stored_crc = struct.unpack_from('<I', raw, 0x2C)[0]
+    buf = bytearray(raw)
+    struct.pack_into('<I', buf, 0x2C, 0)
+    calc_crc = zlib.crc32(buf) & 0xFFFFFFFF
+    if stored_crc != calc_crc:
+        return {
+            'valid': False,
+            'error': f'CRC32 mismatch (stored: 0x{stored_crc:08x}, calculated: 0x{calc_crc:08x})'
+        }
+    
+    media_guid = raw[16:32].hex()
+    media_size, count, crc = struct.unpack_from('<QII', raw, 0x20)
+    
+    if media_size not in (16000000000, 32000000000):
+        return {'valid': False, 'error': f'Unsupported media size: {media_size} (expected 16GB or 32GB)'}
+    
+    if count < 1 or count > 8:
+        return {'valid': False, 'error': f'Invalid partition count: {count} (expected 1..8)'}
+    
+    # openiBoot capacity-dependent derivation
+    shift = ((media_size - 1) >> 10).bit_length()
+    chunk_size = 1 << shift
+    nchunks = media_size // chunk_size
+    bound = LOW + (nchunks - 8) * chunk_size
+    backup_lba = (chunk_size // BLOCK) - 1
+    
+    if nchunks > 1024:
+        return {'valid': False, 'error': f'Chunk count {nchunks} exceeds 1024-entry map limit'}
+    
+    parts = []
+    for i in range(count):
+        e = raw[0x200 + 128*i : 0x200 + 128*(i+1)]
+        ptype = e[:16].hex()
+        puuid = e[16:32].hex()
+        start, end, attr = struct.unpack_from('<QQQ', e, 32)
+        name = e[56:128].decode('utf-16le', 'replace').split('\0')[0]
+        
+        if start < LOW or end > bound or start >= end:
+            return {'valid': False, 'error': f'Partition {i} ({name}) out of bounds: {start}..{end} (bound {bound})'}
+        if start % BLOCK != 0 or end % BLOCK != 0:
+            return {'valid': False, 'error': f'Partition {i} ({name}) not block-aligned: {start}..{end}'}
+        
+        # Check overlaps with preceding partitions
+        for prev in parts:
+            if start < prev['end'] and end > prev['start']:
+                return {'valid': False, 'error': f'Partition {i} ({name}) overlaps {prev["name"]}'}
+        
+        n_chunks = (end - start + chunk_size - 1) // chunk_size
+        parts.append({
+            'index': i,
+            'name': name,
+            'start': start,
+            'end': end,
+            'size_bytes': end - start,
+            'size_gib': (end - start) / (1 << 30),
+            'chunks': n_chunks,
+            'attr': hex(attr),
+            'uuid': puuid,
+            'type': ptype
+        })
+    
+    cmap = list(struct.unpack_from('<1024H', raw, 0x800))
+    if cmap[0] != M_HEADER:
+        return {'valid': False, 'error': f'Chunk 0 is not M_HEADER (0xF000): 0x{cmap[0]:04x}'}
+    
+    for c in range(nchunks, 1024):
+        if cmap[c] != M_PAST:
+            return {'valid': False, 'error': f'Chunk {c} past media is not M_PAST (0xF3FF): 0x{cmap[c]:04x}'}
+    
+    # Check partition chunk map consistency
+    for p_idx, p in enumerate(parts):
+        have_indices = []
+        for c_idx in range(1, nchunks):
+            v = cmap[c_idx]
+            if v < 0xF000 and (v >> 12) == p_idx:
+                have_indices.append(v & 0xFFF)
+        if sorted(have_indices) != list(range(p['chunks'])):
+            return {
+                'valid': False,
+                'error': f'Partition {p_idx} ({p["name"]}) chunk map does not cover 0..{p["chunks"]-1} exactly'
+            }
+    
+    free_chunks = [c for c in range(1, nchunks) if cmap[c] == M_FREE]
+    
+    return {
+        'valid': True,
+        'media_guid': media_guid,
+        'media_size': media_size,
+        'media_size_gb': media_size / 1e9,
+        'chunk_size_bytes': chunk_size,
+        'chunk_size_mib': chunk_size >> 20,
+        'total_chunks': nchunks,
+        'capacity_bound': bound,
+        'backup_lba': backup_lba,
+        'partition_count': count,
+        'partitions': parts,
+        'free_chunks_count': len(free_chunks),
+        'free_chunks': free_chunks,
+        'stored_crc': f'0x{crc:08x}'
+    }
+
