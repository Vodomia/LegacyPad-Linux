+            'component': 'LwVM Primary Header',
+            'status': 'VERIFIED',
+            'details': f'Valid {lw["media_size_gb"]:.0f} GB layout ({lw["chunk_size_mib"]} MiB chunks, {lw["partition_count"]} parts, CRC {lw["stored_crc"]}).'
+        })
