+            if 'backup_matches_primary' in res:
+                print(f"  Backup Integrity: {'BIT-FOR-BIT IDENTICAL' if res['backup_matches_primary'] else 'MISMATCH / CORRUPT'}")
+            print(f"  Partitions ({lw['partition_count']}):")
+            for p in lw['partitions']:
