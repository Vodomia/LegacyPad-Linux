+        for prof_key, prof in KNOWN_PROFILES.items():
+            if prof_key in fw:
+                matched_profile = prof
+                break
+        if matched_profile:
+            findings.append({
+                'component': 'PPN Firmware & Profile',
+                'status': 'SUPPORTED',
+                'details': f'Firmware "{fw}" matches tested {matched_profile["name"]} profile.'
+            })
+        else:
+            findings.append({
+                'component': 'PPN Firmware & Profile',
+                'status': 'READ_ONLY_PROBE_ALLOWED',
+                'details': f'Firmware "{fw}" is an untested geometry. Upstream PR #52 permits safe read-only probe, but program/erase and FTL mounting are strictly blocked.'
+            })
+            driver_ready = False
