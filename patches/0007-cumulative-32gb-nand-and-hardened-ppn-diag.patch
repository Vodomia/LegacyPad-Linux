+[    1.100000] apple_ppn 31200000.ppn: device registered
+"""
+        parsed_a = nand_diagnose.parse_dmesg_ppn_diag(ambig_dmesg)
+        self.assertIsNone(parsed_a['read_only'], "Ambiguous log must remain UNKNOWN (None), never default to True")
+        self.assertIsNone(parsed_a['write_allowed'])
