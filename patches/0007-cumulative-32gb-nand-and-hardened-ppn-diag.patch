+def diagnose_from_files(now_path, backup_path=None):
+    """Run diagnosis using offline header dumps (strictly host-only)."""
+    diag = {'mode': 'offline_headers'}
+    if not os.path.isfile(now_path):
+        return {'error': f'Header file not found: {now_path}'}
+    
+    with open(now_path, 'rb') as f:
+        now_raw = f.read()
+    
+    diag['lwvm'] = parse_lwvm_header(now_raw)
+    
+    if backup_path and os.path.isfile(backup_path):
+        with open(backup_path, 'rb') as f:
+            backup_raw = f.read()
+        diag['backup_header'] = parse_lwvm_header(backup_raw)
+        diag['backup_matches_primary'] = (now_raw == backup_raw)
+    
+    audit_hardware_compatibility(diag)
+    return diag
+
+
+def diagnose_live_ios():
+    """Run safe, strictly read-only diagnostics over Cascadia SSH transport."""
+    diag = {'mode': 'live_ios_safe'}
+    
+    # Check utilities first
+    diag['missing_utilities'] = check_ios_utilities()
+    
+    # 1. System info
+    model = run_ios_cmd('sysctl -n hw.machine') or 'unknown'
+    os_build = run_ios_cmd('sysctl -n kern.osversion') or 'unknown'
+    diag['system'] = {'machine': model, 'build': os_build}
+    
+    # 2. Kernel dmesg search for PPN / NAND boot log
+    dmesg = run_ios_cmd('dmesg') or ''
+    ppn_lines = [l for l in dmesg.splitlines() if re.search(r'ppn|nand|fmi|hynix|toshiba|sandisk|samsung|applep105', l, re.IGNORECASE)]
+    diag['kernel_nand_logs'] = ppn_lines
+    
+    for line in ppn_lines:
+        if '040472P_HYNIX_B_' in line:
+            diag['ppn_firmware'] = '040472P_HYNIX_B_'
+        m = re.search(r'firmware[:\s]+([0-9A-Za-z_]+)', line, re.IGNORECASE)
+        if m:
+            diag['ppn_firmware'] = m.group(1)
+        m_blk = re.search(r'blocks[:\s]+(\d+)', line, re.IGNORECASE)
+        if m_blk:
+            diag['blocks_per_cau'] = int(m_blk.group(1))
+
+    # 3. IORegistry query for DeviceTree CE bitmap (read-only)
+    ioreg_ce = run_ios_cmd('ioreg -p IODeviceTree -k ce-bitmap -l 2>/dev/null') or ''
+    m_ce = re.search(r'"ce-bitmap"\s*=\s*<([0-9a-fA-F]+)>', ioreg_ce)
+    if m_ce:
+        diag['ce_bitmap'] = m_ce.group(1)
+
+    # 4. Read LwVM primary header (LBA 0) via block device /dev/rdisk0 (100% safe, no /dev/mem)
+    header_raw = run_ios_cmd_bytes('dd if=/dev/rdisk0 bs=4096 count=1 2>/dev/null')
+    if header_raw and len(header_raw) == BLOCK:
+        diag['lwvm'] = parse_lwvm_header(header_raw)
+        backup_lba = diag['lwvm'].get('backup_lba', 4095)
+        # Read backup header
+        backup_raw = run_ios_cmd_bytes(f'dd if=/dev/rdisk0 bs=4096 skip={backup_lba} count=1 2>/dev/null')
+        if backup_raw and len(backup_raw) == BLOCK:
+            diag['backup_header'] = parse_lwvm_header(backup_raw)
+            diag['backup_matches_primary'] = (header_raw == backup_raw)
+            diag['backup_lba_read'] = backup_lba
+    else:
+        diag['lwvm'] = {'valid': False, 'error': 'Failed to read 4096 bytes from /dev/rdisk0 LBA 0'}
+
+    audit_hardware_compatibility(diag)
+    return diag
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
