+    def test_mocked_success_validator_cannot_bypass_corrupt_crc(self):
+        """Regression test for Reviewer Finding 3:
+        Ensure independent CRC failures cannot be discarded when the iOS validator
+        returns success (e.g. mocked success or compromised validator return).
+        """
+        class MockSuccessValidator:
+            @staticmethod
+            def check(raw, media_size=None, fixcrc=False):
+                # Mock an iOS validator that falsely claims (0, 0, ['mocked success'])
+                return 0, 0, ['mocked iOS validator claim: valid']
+
+        corrupt_crc = bytearray(self.now_32_raw)
+        corrupt_crc[0x900] ^= 0xAA  # Invalidate payload without fixing CRC
+
+        with patch.dict("sys.modules", {"lwvm_validate": MockSuccessValidator}):
+            c, v, msgs = lwvm.ios_check(bytes(corrupt_crc), fixcrc=False)
+            self.assertEqual(c, -1, "Independent CRC failure (c = -1) must NEVER be discarded")
+            self.assertNotEqual(v, 0, "Validator return v must NOT be 0 when CRC is corrupted")
+            self.assertEqual(v, -1, "Validator return must be forced to -1 on CRC corruption")
+            self.assertTrue(any("independent CRC failure cannot be bypassed" in m for m in msgs))
+
+            # check_ios must refuse to certify the header despite validator's claim
+            h = lwvm.Header(self.now_32_raw)
+            with self.assertRaises(lwvm.LwvmError) as ctx:
+                lwvm.check_ios(h, bytes(corrupt_crc))
+            self.assertIn("CRC check -1", str(ctx.exception))
+
+    def test_nand_diagnose_header_validation_and_audit(self):
+        """Regression test for Reviewer Finding 2:
+        Verify nand_diagnose rejects malformed/corrupt headers, detects dual-header
+        mismatches, and refuses to report hardware readiness on incomplete data.
+        """
+        import nand_diagnose
