+        else:
+            findings.append({
+                'component': 'NAND Blocks/CAU',
+                'status': 'READ_ONLY_PROBE_ALLOWED',
+                'details': f'Blocks per CAU ({blocks}) is an untested physical configuration. Read-only probe allowed; writes blocked.'
+            })
+            driver_ready = False
+    else:
+        findings.append({
+            'component': 'NAND Blocks/CAU',
+            'status': 'UNVERIFIED',
+            'details': 'Physical block count unverified. SFTL superblock allocation cannot be proven.'
+        })
+        driver_ready = False
+
+    # 6. Physical vs Logical Capacity & Geometry Cross-Validation
+    if lw.get('valid'):
+        logical_size = lw.get('media_size', 0)
+        if matched_profile:
+            profile_physical_bytes = matched_profile['reported_lbas'] * 4096
+            if logical_size >= 24_000_000_000 and profile_physical_bytes < 20_000_000_000:
+                findings.append({
+                    'component': 'Physical vs Logical Capacity',
+                    'status': 'BLOCKED',
+                    'details': (f'Capacity mismatch: LwVM header defines {logical_size / 1e9:.2f} GB logical media, '
+                                f'but matched PPN profile ({matched_profile["name"]}) provides only '
+                                f'{profile_physical_bytes / 1e9:.2f} GB physical LBAs. Driver not ready.')
+                })
+                driver_ready = False
+            elif logical_size < 20_000_000_000 and profile_physical_bytes >= 24_000_000_000:
+                findings.append({
+                    'component': 'Physical vs Logical Capacity',
+                    'status': 'BLOCKED',
+                    'details': f'Capacity mismatch: 16 GB LwVM header on 32 GB physical profile.'
+                })
+                driver_ready = False
+            else:
+                findings.append({
+                    'component': 'Physical vs Logical Capacity',
+                    'status': 'VERIFIED',
+                    'details': f'Logical media size ({logical_size / 1e9:.2f} GB) aligns with physical profile geometry.'
+                })
+        elif blocks:
+            if logical_size >= 24_000_000_000 and blocks in (1064, 2088):
+                findings.append({
+                    'component': 'Physical vs Logical Capacity',
+                    'status': 'BLOCKED',
+                    'details': f'Capacity mismatch: 32 GB LwVM header on 16 GB physical blocks ({blocks} blocks/CAU).'
+                })
+                driver_ready = False
+
+    # 7. Chip Enable Bitmap
+    ce = hw_info.get('ce_bitmap')
+    if ce == '0101':
+        findings.append({
+            'component': 'DeviceTree CE Bitmap',
+            'status': 'SUPPORTED',
+            'details': f'Discovered CE bitmap: 0x{ce}. Dual-bus CE0 active on both channels.'
+        })
+    elif ce:
+        findings.append({
+            'component': 'DeviceTree CE Bitmap',
+            'status': 'BLOCKED',
+            'details': f'Unsupported or mismatched CE bitmap: 0x{ce}. Expected dual-bus 0x0101.'
+        })
+        driver_ready = False
+    else:
+        findings.append({
+            'component': 'DeviceTree CE Bitmap',
+            'status': 'UNVERIFIED',
+            'details': 'CE bitmap unverified on hardware.'
+        })
+        driver_ready = False
+
+    hw_info['audit'] = {
+        'overall_driver_ready': driver_ready,
+        'findings': findings
+    }
