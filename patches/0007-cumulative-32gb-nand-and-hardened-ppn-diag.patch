+        lba4095_offset_read = bytes(4096)
+        self.assertNotEqual(lba0_updated, lba4095_offset_read, "Reading LBA 4095 on 32GB gives false mismatch")
+        # But reading dynamic backup LBA (8191) gives identical copy:
