+        self.assertFalse(parsed_w['read_only'])
+        self.assertTrue(parsed_w['write_allowed'])
+
+        # Case B: Ambiguous / unknown log text -> read_only remains None (UNKNOWN, NOT safe!)
+        ambig_dmesg = """
