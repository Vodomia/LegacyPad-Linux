+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+# Derived from Project Cascadia (https://github.com/rzxvx/Project-Cascadia) for LegacyPad-Linux
+"""
+Safe Read-Only NAND & Hardware Diagnostic Tool for iPad mini 1 (iPad2,5).
+
+SAFETY INVARIANTS:
+1. When iOS is running, NEVER touch /dev/mem or physical FMC/FMI hardware registers.
+   Direct register access while iOS's kernel driver owns the hardware causes bus wedging
+   or kernel panics. All iOS queries use read-only OS interfaces: sysctl, dmesg,
+   IORegistry/DeviceTree, and block-layer reads via /dev/rdisk0.
+2. In Linux, operates strictly in read-only / unmounted mode.
+3. Evaluates discovered physical hardware against Cascadia driver constraints (apple_ppn, sftl).
+4. Strict fail-closed validation: any corrupted, unaligned, out-of-bounds, or incomplete
+   hardware data strictly sets readiness to NOT READY (BLOCKED / UNVERIFIED).
+"""
+
+import argparse
+import json
+import os
+import re
+import shlex
+import struct
+import subprocess
+import sys
+import zlib
+
+BLOCK = 4096
+MAGIC = bytes.fromhex('6a9088cf8afd630ae351e24887e0b98b')
+M_HEADER, M_FREE, M_PAST = 0xF000, 0xF111, 0xF3FF
+LOW = 24576  # 0x4000 + 2 * BLOCK
+
+# Cascadia Linux driver hardcoded expectations (for compatibility audit)
+DRIVER_EXPECTATIONS = {
+    'firmware': '040472P_HYNIX_B_',
+    'blocks_per_cau': 1064,
+    'cau_per_ce': 2,
+    'mlc_pages_per_block': 256,
+    'slc_pages_per_block': 128,
+    'page_size': 16384,
+    'meta_size': 64,
+    'ce_bitmap': 0x101,  # CE0 on bus 0, CE0 on bus 1
+    'sftl_total_lbas_16': 3906266,
+    'sftl_total_lbas_32': 7812516,  # 32000000000 / 4096 = 7812500 + 16 hidden
+}
+
+# Upstream Cascadia PR #52 known package profiles
+KNOWN_PROFILES = {
+    '040472P_HYNIX_B_': {
+        'name': 'Reference 16 GB (Hynix B)',
+        'blocks': 1064,
+        'mlc_pages': 256,
+        'slc_pages': 128,
+        'page_bits': 8,
+        'block_bits': 11,
+        'cau_bits': 4,
+        'num_sb': 1055,
+        'reported_lbas': 3906250,
+        'writable': True,
