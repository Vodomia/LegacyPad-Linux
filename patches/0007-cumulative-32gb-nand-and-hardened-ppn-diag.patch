+            print(f"  Free Chunks:      {lw['free_chunks']}")
+        elif 'lwvm' in res:
+            print(f"\n[!] LwVM Header Validation Failed: {res['lwvm'].get('error')}")
+
+        print('\n[2] Hardware Compatibility Audit against Linux Driver:')
+        audit = res.get('audit', {})
+        for f in audit.get('findings', []):
+            status_box = f"[{f['status']}]"
+            print(f"  {status_box:<20} {f['component']}: {f['details']}")
+        
+        print('\n[3] Overall Installation Readiness Determination:')
+        if audit.get('overall_driver_ready'):
+            print('  >>> STATUS: READY - Physical hardware verified and driver compatible.')
+        else:
+            print('  >>> STATUS: NOT READY (BLOCKED)')
+            print('  >>> Reason: Physical NAND controller/FTL compatibility has NOT been proven')
+            print('              on this physical 32 GB package. Flash/partitioning must NOT proceed.')
+        print('======================================================================')
+
+    return 0
+
