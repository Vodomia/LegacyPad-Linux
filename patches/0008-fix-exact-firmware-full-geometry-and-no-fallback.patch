+if b'tx_page' in vml:
+    sys.exit('FATAL: Flash write function tx_page detected in diagnostic vmlinux! Must be excluded by SFTL_NO_WRITE.')
+
+print('   Diagnostic kernel artifacts verified (zImage, vmlinux, kernel-config synchronized from same build)')
